import * as vscode from 'vscode';
import Anthropic from '@anthropic-ai/sdk';

interface Message {
    role: 'user' | 'assistant';
    content: string;
}

export class ChatViewProvider implements vscode.WebviewViewProvider {
    public static readonly viewType = 'dicomChatView';
    private _view?: vscode.WebviewView;
    private _messages: Message[] = [];
    private _anthropic?: Anthropic;

    constructor(private readonly _extensionUri: vscode.Uri) {}

    public resolveWebviewView(
        webviewView: vscode.WebviewView,
        context: vscode.WebviewViewResolveContext,
        _token: vscode.CancellationToken
    ) {
        this._view = webviewView;

        webviewView.webview.options = {
            enableScripts: true,
            localResourceRoots: [this._extensionUri]
        };

        webviewView.webview.html = this._getHtmlForWebview(webviewView.webview);

        // Webviewからのメッセージを受信
        webviewView.webview.onDidReceiveMessage(async (data) => {
            switch (data.type) {
                case 'sendMessage':
                    await this.handleUserMessage(data.message);
                    break;
                case 'clearChat':
                    this.clearChat();
                    break;
            }
        });

        // APIキーの初期化を試みる
        this.initializeAnthropicClient();
    }

    private initializeAnthropicClient() {
        const config = vscode.workspace.getConfiguration('dicomChat');
        const apiKey = config.get<string>('apiKey');

        console.log('APIキーの確認:', apiKey ? `設定済み (長さ: ${apiKey.length})` : '未設定');

        if (apiKey && apiKey.trim() !== '') {
            try {
                this._anthropic = new Anthropic({
                    apiKey: apiKey.trim()
                });
                console.log('Anthropic クライアント初期化成功');
            } catch (error) {
                console.error('Anthropic クライアント初期化エラー:', error);
                this._anthropic = undefined;
            }
        } else {
            this._anthropic = undefined;
        }
    }

    private async handleUserMessage(message: string) {
        if (!message.trim()) {
            return;
        }

        // APIキーのチェック
        this.initializeAnthropicClient();
        if (!this._anthropic) {
            vscode.window.showErrorMessage(
                'Claude API キーが設定されていません。設定 (Ctrl+,) から「dicomChat.apiKey」を検索して API キーを入力してください。'
            );
            this._view?.webview.postMessage({
                type: 'setLoading',
                loading: false
            });
            return;
        }

        // ユーザーメッセージを追加
        this._messages.push({
            role: 'user',
            content: message
        });

        // UIに表示
        this._view?.webview.postMessage({
            type: 'addMessage',
            role: 'user',
            content: message
        });

        // ローディング表示
        this._view?.webview.postMessage({
            type: 'setLoading',
            loading: true
        });

        try {
            // Claude APIを呼び出し
            const config = vscode.workspace.getConfiguration('dicomChat');
            const model = config.get<string>('model') || 'claude-3-5-sonnet-20241022';
            const maxTokens = config.get<number>('maxTokens') || 4096;

            console.log('Claude API 呼び出し開始:', { model, maxTokens, messageCount: this._messages.length });

            const response = await this._anthropic.messages.create({
                model: model,
                max_tokens: maxTokens,
                messages: this._messages.map(msg => ({
                    role: msg.role,
                    content: msg.content
                })),
                system: this.getSystemPrompt()
            });

            // アシスタントの応答を取得
            const assistantMessage = response.content[0].type === 'text'
                ? response.content[0].text
                : '';

            this._messages.push({
                role: 'assistant',
                content: assistantMessage
            });

            // UIに表示
            this._view?.webview.postMessage({
                type: 'addMessage',
                role: 'assistant',
                content: assistantMessage
            });

        } catch (error: any) {
            console.error('Claude API エラー:', error);

            let errorMessage = 'エラーが発生しました';
            let errorDetails = '';

            if (error.status) {
                errorDetails += `ステータスコード: ${error.status}\n`;
            }

            if (error.message) {
                errorMessage = error.message;
                errorDetails += `メッセージ: ${error.message}\n`;
            }

            if (error.error?.type) {
                errorDetails += `エラータイプ: ${error.error.type}\n`;
            }

            if (error.error?.message) {
                errorDetails += `詳細: ${error.error.message}\n`;
            }

            if (error.status === 401) {
                errorMessage = 'APIキーが無効です';
                errorDetails += '\n✋ APIキーを確認してください。sk-ant- で始まる正しいキーが設定されているか確認してください。';
            } else if (error.status === 429) {
                errorMessage = 'レート制限に達しました';
                errorDetails += '\n⏰ しばらく待ってから再試行してください。';
            } else if (error.status === 500 || error.status === 502 || error.status === 503) {
                errorMessage = 'Anthropic APIサーバーエラー';
                errorDetails += '\n🔧 Anthropic側の問題です。しばらく待ってから再試行してください。';
            }

            vscode.window.showErrorMessage(`Claude API エラー: ${errorMessage}`);

            this._view?.webview.postMessage({
                type: 'addMessage',
                role: 'assistant',
                content: `❌ エラー: ${errorMessage}\n\n${errorDetails}\n\n完全なエラー情報:\n${JSON.stringify(error, null, 2)}`
            });
        } finally {
            // ローディング解除
            this._view?.webview.postMessage({
                type: 'setLoading',
                loading: false
            });
        }
    }

    private getSystemPrompt(): string {
        return `あなたはDICOM医用画像ビューワーの開発を支援するAIアシスタントです。
Javaで開発されたDICOMビューワープロジェクトに関する質問に答え、コードの説明や実装のアドバイスを提供します。

主な機能：
- DICOMファイルの読み込みと表示
- サムネイル表示とナビゲーション
- 画像のウィンドウ幅/ウィンドウレベル調整
- マルチフレーム画像の再生
- アノテーション表示

丁寧で分かりやすい日本語で回答してください。`;
    }

    public clearChat() {
        this._messages = [];
        this._view?.webview.postMessage({
            type: 'clearMessages'
        });
    }

    public sendMessage(message: string) {
        this.handleUserMessage(message);
    }

    private _getHtmlForWebview(webview: vscode.Webview) {
        return `<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DICOM Chat</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background-color: var(--vscode-editor-background);
            color: var(--vscode-editor-foreground);
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        #chat-container {
            flex: 1;
            overflow-y: auto;
            padding: 16px;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .message {
            padding: 12px;
            border-radius: 8px;
            max-width: 85%;
            word-wrap: break-word;
            white-space: pre-wrap;
        }

        .message.user {
            background-color: var(--vscode-input-background);
            border: 1px solid var(--vscode-input-border);
            align-self: flex-end;
            margin-left: auto;
        }

        .message.assistant {
            background-color: var(--vscode-editor-inactiveSelectionBackground);
            border: 1px solid var(--vscode-panel-border);
            align-self: flex-start;
        }

        #input-container {
            padding: 12px;
            background-color: var(--vscode-panel-background);
            border-top: 1px solid var(--vscode-panel-border);
            display: flex;
            gap: 8px;
        }

        #message-input {
            flex: 1;
            padding: 8px 12px;
            background-color: var(--vscode-input-background);
            color: var(--vscode-input-foreground);
            border: 1px solid var(--vscode-input-border);
            border-radius: 4px;
            font-size: 14px;
            outline: none;
        }

        #message-input:focus {
            border-color: var(--vscode-focusBorder);
        }

        #send-button {
            padding: 8px 16px;
            background-color: var(--vscode-button-background);
            color: var(--vscode-button-foreground);
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 500;
        }

        #send-button:hover {
            background-color: var(--vscode-button-hoverBackground);
        }

        #send-button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .loading {
            padding: 12px;
            text-align: center;
            color: var(--vscode-descriptionForeground);
            font-style: italic;
        }

        #clear-button {
            padding: 4px 12px;
            background-color: transparent;
            color: var(--vscode-button-secondaryForeground);
            border: 1px solid var(--vscode-button-border);
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
        }

        #clear-button:hover {
            background-color: var(--vscode-button-secondaryHoverBackground);
        }

        .header {
            padding: 12px;
            background-color: var(--vscode-panel-background);
            border-bottom: 1px solid var(--vscode-panel-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .header h3 {
            font-size: 14px;
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="header">
        <h3>DICOM Chat Assistant</h3>
        <button id="clear-button">クリア</button>
    </div>
    <div id="chat-container"></div>
    <div id="input-container">
        <input type="text" id="message-input" placeholder="メッセージを入力..." />
        <button id="send-button">送信</button>
    </div>

    <script>
        const vscode = acquireVsCodeApi();
        const chatContainer = document.getElementById('chat-container');
        const messageInput = document.getElementById('message-input');
        const sendButton = document.getElementById('send-button');
        const clearButton = document.getElementById('clear-button');

        let isLoading = false;

        // メッセージを送信
        function sendMessage() {
            const message = messageInput.value.trim();
            if (message && !isLoading) {
                vscode.postMessage({
                    type: 'sendMessage',
                    message: message
                });
                messageInput.value = '';
            }
        }

        // 送信ボタンのクリック
        sendButton.addEventListener('click', sendMessage);

        // Enterキーで送信
        messageInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendMessage();
            }
        });

        // クリアボタン
        clearButton.addEventListener('click', () => {
            vscode.postMessage({
                type: 'clearChat'
            });
        });

        // VS Codeからのメッセージを受信
        window.addEventListener('message', (event) => {
            const message = event.data;

            switch (message.type) {
                case 'addMessage':
                    addMessageToChat(message.role, message.content);
                    break;
                case 'clearMessages':
                    chatContainer.innerHTML = '';
                    break;
                case 'setLoading':
                    isLoading = message.loading;
                    sendButton.disabled = isLoading;
                    if (isLoading) {
                        const loadingDiv = document.createElement('div');
                        loadingDiv.className = 'loading';
                        loadingDiv.id = 'loading-indicator';
                        loadingDiv.textContent = '応答を生成中...';
                        chatContainer.appendChild(loadingDiv);
                    } else {
                        const loadingIndicator = document.getElementById('loading-indicator');
                        if (loadingIndicator) {
                            loadingIndicator.remove();
                        }
                    }
                    scrollToBottom();
                    break;
            }
        });

        // メッセージをチャットに追加
        function addMessageToChat(role, content) {
            const messageDiv = document.createElement('div');
            messageDiv.className = \`message \${role}\`;
            messageDiv.textContent = content;
            chatContainer.appendChild(messageDiv);
            scrollToBottom();
        }

        // 最下部にスクロール
        function scrollToBottom() {
            chatContainer.scrollTop = chatContainer.scrollHeight;
        }

        // 初期フォーカス
        messageInput.focus();
    </script>
</body>
</html>`;
    }
}
